// ============================================================================
// bench/kjs/mem_selsort.kjs — bellek-yoğun selection sort benchmark (KJS)
//
// saQut referansı: bench/sqt/mem_selsort.sqt ile birebir aynı algoritma.
// Seçim: selection sort `<` sıkı karşılaştırmasıyla İLK minimumu seçer
// (deterministik, stabil değil). KJS'te typed array yok; düz Array kullanılır.
// 32-bit wrap: Math.imul + |0 (Node sürümüyle aynı). Determinizm sözleşmesi:
// bench/README.md. CHECKSUM signed int32'dir.
// ============================================================================

var SIZE = 1200;
var ROUNDS = 15;

function main() {
    var seed = 987654321 | 0;
    var t0 = Date.now();
    var acc = 0 | 0;
    for (var run = 0; run < ROUNDS; run++) {
        var arr = [];
        for (var i = 0; i < SIZE; i++) {
            seed = (Math.imul(seed, 1103515245) + 12345) | 0;
            arr.push(seed);
        }

        // selection sort — bilinçli olarak optimize edilmemiş
        for (var i = 0; i < SIZE - 1; i++) {
            var minIdx = i;
            for (var j = i + 1; j < SIZE; j++) {
                if (arr[j] < arr[minIdx]) {
                    minIdx = j;
                }
            }
            if (minIdx !== i) {
                var tmp = arr[i];
                arr[i] = arr[minIdx];
                arr[minIdx] = tmp;
            }
        }

        acc = ((acc ^ arr[0]) ^ arr[SIZE >> 1]) ^ arr[SIZE - 1];
    }
    var ms = Date.now() - t0;

    print("CHECKSUM=" + acc);
    print("ELAPSED_MS=" + ms);
}

main();
