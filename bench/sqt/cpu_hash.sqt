// ============================================================================
// saQut benchmark — CPU-yoğun: FNV-1a 32-bit hash zinciri (bench/sqt/)
// ============================================================================
//
// Saf hesaplama yükü: tampon üzerinde tekrarlanan FNV-1a hash turu.
// Arama tablosu yok, dal az, çarpma+xor yoğun — derleyici/interpreter
// aritmetik hızını ölçer. Kriptografik güvenlik AMAÇ DEĞİLDIR.
//
// Determinizm sözleşmesi (cross-language):
//   - int = 32-bit, taşma tanımlı 2's-complement wrap (ADR-040).
//   - Doldurma: LCG x = x*1103515245 + 12345 (glibc rand() formülü).
//   - Hash: h ^= buf[i]; h *= 16777619; offset basis -2128831035
//     (= 2166136261 mod 2^32'nin signed karşılığı; literal aralık denetimi
//     nedeniyle negatif yazılır).
//   - CHECKSUM = bütün turlardaki h değerlerinin xor'u.
//     Node.js Math.imul, Python/PHP & 0xFFFFFFFF maskesi ile birebir
//     eşleşmek zorundadır.
//
// Parametre ayarı: size/rounds aşağıdaki sabitlerden. Süre program içinde
// date.now()/diffMillis ile ölçülür (wall-clock); dışarıdan `time` ikinci
// kanaldır. Timeout: tests runner tarafında zorunlu (sonsuz döngü koruması).
// ============================================================================

import {now, diffMillis} from date;

int main() {
    int size = 2048;
    int rounds = 3000;

    // ── Tamponu bir kez doldur (LCG) ────────────────────────────────────────
    int[] buf = [];
    int seed = 123456789;
    for (int i = 0; i < size; i++) {
        seed = seed * 1103515245 + 12345;
        buf.push(seed);
    }

    // ── Ölçülen bölüm ────────────────────────────────────────────────────────
    date t0 = now();
    int acc = 0;
    int basis = -2128831035;
    for (int r = 0; r < rounds; r++) {
        // NOT: basis değişkende tutulur — literal-bir-XOR-operandı olarak
        // negatif literal 2'lik değer kayması üretiyor (bulgu #230, izole
        // deneyle teyit): (-2128831035) ^ 1 = -2128831034 (doğrusu
        // -2128831036). Değişkenli yol doğru çalışır. Literal-form hatası
        // kapatıldığında bu yorum ve değişkensiz biçim yeniden denenebilir.
        int h = (basis ^ r);
        for (int i = 0; i < size; i++) {
            h = (h ^ buf[i]) * 16777619;
        }
        acc = acc ^ h;
    }
    date t1 = now();

    longint ms = diffMillis(t1, t0);

    print("CHECKSUM=");
    print(acc);
    print("\n");
    print("ELAPSED_MS=");
    print(ms);
    print("\n");
    return 0;
}
