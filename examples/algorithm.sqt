// Örnek: Kabarcık sıralama + string işleme built-in metodlarla

void bubbleSort(int[] arr) {
    int n = int::length(arr);
    int i = 0;
    while (i < n - 1) {
        int j = 0;
        while (j < n - 1 - i) {
            if (arr[j] > arr[j + 1]) {
                int tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

int main() {
    int[] nums = [5, 2, 8, 1, 9, 3];
    print(int::length(nums));

    bubbleSort(nums);

    int i = 0;
    while (i < int::length(nums)) {
        print(nums[i]);
        i = i + 1;
    }

    int? found = int::indexOf(nums, 8);
    if (found != null) {
        print(found);
    }

    int[] half = int::slice(nums, 0, 3);
    print(int::length(half));
    print(half[0]);
    print(half[2]);

    string[] words = ["hello", "world", "saqut"];
    string[] upper_words = [];
    int k = 0;
    while (k < string::length(words)) {
        string w = string::upper(words[k]);
        string::push(upper_words, w);
        k = k + 1;
    }

    int m = 0;
    while (m < string::length(upper_words)) {
        print(upper_words[m]);
        m = m + 1;
    }

    string[] parts = string::split("one two three", " ");
    print(parts[1]);

    return 0;
}
