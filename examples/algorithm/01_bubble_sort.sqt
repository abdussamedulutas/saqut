// Test: Bubble Sort - çift iç içe for, ARRAY_SET/GET
int main() {
    int[] arr = [5, 2, 8, 1, 9, 3, 7, 4, 6, 10];
    int n = 10;

    for (int i = 0; i < n - 1; i = i + 1) {
        for (int j = 0; j < n - i - 1; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                int tmp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
        }
    }

    for (int k = 0; k < n; k = k + 1) {
        print(arr[k]);
    }
    return 0;
}
