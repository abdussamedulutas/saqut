// Test: Selection Sort - global sayaç
int comparisons = 0;

void selectionSort(int[] arr, int n) {
    for (int i = 0; i < n - 1; i = i + 1) {
        int minIdx = i;
        for (int j = i + 1; j < n; j = j + 1) {
            comparisons += 1;
            if (arr[j] < arr[minIdx]) {
                minIdx = j;
            }
        }
        int tmp = arr[minIdx];
        arr[minIdx] = arr[i];
        arr[i] = tmp;
    }
}

int main() {
    int[] arr = [64, 25, 12, 22, 11];
    int n = 5;

    selectionSort(arr, n);

    for (int k = 0; k < n; k = k + 1) {
        print(arr[k]);
    }
    print(comparisons);

    return 0;
}
