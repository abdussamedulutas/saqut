// Test: Insertion Sort - && kısa devre
int main() {
    int[] arr = [5, 3, 1, 6, 4];
    int n = 5;

    for (int i = 1; i < n; i = i + 1) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] > key) {
            arr[j + 1] = arr[j];
            j = j - 1;
        }
        arr[j + 1] = key;
    }

    for (int k = 0; k < n; k = k + 1) {
        print(arr[k]);
    }
    return 0;
}
