int collatz_steps(int n) {
    int steps = 0;
    while (n != 1) {
        if (n % 2 == 0) { n = n / 2; }
        else { n = n * 3 + 1; }
        steps = steps + 1;
    }
    return steps;
}

int main() {
    print(collatz_steps(27));
    print(collatz_steps(1));
    print(collatz_steps(6));
    return 0;
}
