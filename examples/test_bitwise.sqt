int global_x = 10;
int global_y = 3;

int main() {
    // global değişken testi (#38)
    print(global_x);
    print(global_y);

    // bitsel AND, OR, SHL, SHR (#45)
    int a = 12;
    int b = 10;
    print(a & b);
    print(a | b);
    print(1 << 3);
    print(16 >> 2);

    // unary ~ ve !
    int c = 0;
    print(!c);
    int d = 5;
    print(!d);
    print(~0);

    return 0;
}
