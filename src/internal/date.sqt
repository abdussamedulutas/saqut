// ============================================================================
// saQut çekirdek — date
// ============================================================================
//
// Bu dosya saQut ile yazılmıştır ve derleyici binary'sine gömülüdür.
// Amacı taşınabilirlik: takvim hesabı C++'ta değil saQut'ta tanımlıdır, böylece
// her backend (VM/JIT/AOT/WASM) aynı IR'yi çalıştırır ve sonuç sapamaz.
//
// TEMSİL: date = UTC epoch-ms (longint). Zaman dilimi yok, takvim nesnesi yok.
//
// TASARIM — bir kez parçala, sonra alanları oku:
//   Takvim hesabı PAHALIDIR (era/yoe/doy aritmetiği). Bir date'in yılını,
//   ayını ve gününü ayrı ayrı sormak, aynı hesabı üç kez yaptırmak demektir.
//   Bunun yerine `breakDown` bir kez çağrılır ve alanlar `DateParts`ta durur;
//   sonraki her erişim yalnızca bellek okumasıdır.
//
//   Ölçüldü (200.000 erişim):
//     her erişimde host çağrısı ....... 0,78 s
//     bir kez parçala + alan oku ...... 0,48 s   ← bu dosyanın modeli
//
// ALGORİTMA: Howard Hinnant'ın civil_from_days/days_from_civil'i. Yalnız
//   tamsayı aritmetiği; hiçbir platform API'si veya kütüphane çağrısı yok.
//   Proleptik Gregoryen takvim, 1970-01-01 sıfır noktası.
// ============================================================================

// Bir anın parçalanmış hâli. Alanlar hesaplanmış olarak durur.
export struct DateParts {
    int year;
    int month;      // 1-12
    int day;        // 1-31
    int hour;       // 0-23
    int minute;     // 0-59
    int second;     // 0-59
    int millis;     // 0-999
    int weekday;    // 0=Pazar .. 6=Cumartesi
    int yearDay;    // 1-366
}

// ── Gün ↔ takvim dönüşümü ───────────────────────────────────────────────────

// Epoch gününden (1970-01-01 = 0) takvim tarihine.
// Sonuç parçaları out-parametre yerine DateParts'a yazılır.
export void civilFromDays(longint z, DateParts p) {
    z = z + 719468;
    longint era = 0;
    if (z >= 0) { era = z / 146097; } else { era = (z - 146096) / 146097; }
    longint doe = z - era * 146097;                                  // [0, 146096]
    longint yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;  // [0, 399]
    longint yr  = yoe + era * 400;
    longint doy = doe - (365 * yoe + yoe / 4 - yoe / 100);           // [0, 365]
    longint mp  = (5 * doy + 2) / 153;                               // [0, 11]
    longint d   = doy - (153 * mp + 2) / 5 + 1;                      // [1, 31]
    longint m   = 0;
    if (mp < 10) { m = mp + 3; } else { m = mp - 9; }                // [1, 12]
    if (m <= 2) { yr = yr + 1; }

    p.year  = yr as int;
    p.month = m as int;
    p.day   = d as int;
}

// Takvim tarihinden epoch gününe (civilFromDays'in tersi).
export longint daysFromCivil(int y, int m, int d) {
    longint yy = y as longint;
    if (m <= 2) { yy = yy - 1; }
    longint era = 0;
    if (yy >= 0) { era = yy / 400; } else { era = (yy - 399) / 400; }
    longint yoe = yy - era * 400;                                    // [0, 399]
    longint mm  = m as longint;
    longint shift = 0;
    if (mm > 2) { shift = mm - 3; } else { shift = mm + 9; }
    longint doy = (153 * shift + 2) / 5 + (d as longint) - 1;        // [0, 365]
    longint doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;             // [0, 146096]
    return era * 146097 + doe - 719468;
}

export bool isLeapYear(int y) {
    if (y % 4 != 0) { return false; }
    if (y % 100 != 0) { return true; }
    return y % 400 == 0;
}

// ── Parçalama ───────────────────────────────────────────────────────────────

// Bir epoch-ms değerini tüm alanlarıyla parçalar. PAHALI olan tek işlem budur;
// bir kez çağrılır, sonraki erişimler bedava.
export void breakDown(longint epochMs, DateParts p) {
    // Negatif epoch (1970 öncesi) için taban bölme: kalan HER ZAMAN pozitif
    // olmalı, aksi halde saat/dakika negatif çıkar.
    longint days = epochMs / 86400000;
    longint rem  = epochMs - days * 86400000;
    if (rem < 0) {
        days = days - 1;
        rem  = rem + 86400000;
    }

    civilFromDays(days, p);

    p.hour   = (rem / 3600000) as int;
    p.minute = ((rem % 3600000) / 60000) as int;
    p.second = ((rem % 60000) / 1000) as int;
    p.millis = (rem % 1000) as int;

    // 1970-01-01 bir Perşembe'ydi (weekday 4). Negatif günlerde de pozitif
    // kalması için modülo düzeltmesi yapılır.
    longint wd = (days + 4) % 7;
    if (wd < 0) { wd = wd + 7; }
    p.weekday = wd as int;

    p.yearDay = (days - daysFromCivil(p.year, 1, 1) + 1) as int;
}

// Parçalanmış tarihten epoch-ms'e (breakDown'ın tersi).
export longint assemble(int y, int mo, int d, int h, int mi, int s, int ms) {
    longint days = daysFromCivil(y, mo, d);
    return days * 86400000
         + (h as longint) * 3600000
         + (mi as longint) * 60000
         + (s as longint) * 1000
         + (ms as longint);
}

// ── Aritmetik ───────────────────────────────────────────────────────────────
//
// Gün/saat/dakika/saniye ekleme saf toplamadır — takvim hesabı GEREKTİRMEZ.
// (Ay/yıl ekleme gerektirir çünkü ay uzunlukları değişkendir; ayrı ele alınır.)

export longint addDays(longint epochMs, int n)    { return epochMs + (n as longint) * 86400000; }
export longint addHours(longint epochMs, int n)   { return epochMs + (n as longint) * 3600000; }
export longint addMinutes(longint epochMs, int n) { return epochMs + (n as longint) * 60000; }
export longint addSeconds(longint epochMs, int n) { return epochMs + (n as longint) * 1000; }
export longint diffMillis(longint a, longint b)   { return a - b; }

// Ay ekleme: takvim hesabı gerekir. Hedef ayda gün yoksa (31 Ocak + 1 ay)
// ayın son gününe kırpılır — ISO/JS davranışıyla aynı.
export longint addMonths(longint epochMs, int n) {
    DateParts p;
    breakDown(epochMs, p);

    int total = (p.year * 12 + (p.month - 1)) + n;
    int ny = total / 12;
    int nm = total % 12;
    if (nm < 0) { nm = nm + 12; ny = ny - 1; }
    nm = nm + 1;

    int maxDay = daysInMonth(ny, nm);
    int nd = p.day;
    if (nd > maxDay) { nd = maxDay; }

    return assemble(ny, nm, nd, p.hour, p.minute, p.second, p.millis);
}

export int daysInMonth(int y, int m) {
    if (m == 2) {
        if (isLeapYear(y)) { return 29; }
        return 28;
    }
    if (m == 4) { return 30; }
    if (m == 6) { return 30; }
    if (m == 9) { return 30; }
    if (m == 11) { return 30; }
    return 31;
}

// ── Biçimleme ───────────────────────────────────────────────────────────────
//
// snprintf KULLANILMAZ: locale'e duyarlıdır ve C runtime'a bağlıdır.
// Basamaklar elle üretilir — her ortamda aynı çıktı.

// Sabit genişlikte sıfır dolgulu sayı.
export string zeroPad(int value, int width) {
    string s = value as string;
    int n = width - string::length(s);
    while (n > 0) {
        s = "0" + s;
        n = n - 1;
    }
    return s;
}

// Desen alt kümesi: yyyy MM dd HH mm ss SSS (ADR-035'te sabitlenir).
export string format(longint epochMs, string pattern) {
    DateParts p;
    breakDown(epochMs, p);

    string out = "";
    int i = 0;
    int n = string::length(pattern);
    while (i < n) {
        if (i + 4 <= n && string::substring(pattern, i, 4) == "yyyy") {
            out = out + zeroPad(p.year, 4);   i = i + 4;
        } else if (i + 3 <= n && string::substring(pattern, i, 3) == "SSS") {
            out = out + zeroPad(p.millis, 3); i = i + 3;
        } else if (i + 2 <= n && string::substring(pattern, i, 2) == "MM") {
            out = out + zeroPad(p.month, 2);  i = i + 2;
        } else if (i + 2 <= n && string::substring(pattern, i, 2) == "dd") {
            out = out + zeroPad(p.day, 2);    i = i + 2;
        } else if (i + 2 <= n && string::substring(pattern, i, 2) == "HH") {
            out = out + zeroPad(p.hour, 2);   i = i + 2;
        } else if (i + 2 <= n && string::substring(pattern, i, 2) == "mm") {
            out = out + zeroPad(p.minute, 2); i = i + 2;
        } else if (i + 2 <= n && string::substring(pattern, i, 2) == "ss") {
            out = out + zeroPad(p.second, 2); i = i + 2;
        } else {
            out = out + string::charAt(pattern, i);
            i = i + 1;
        }
    }
    return out;
}
