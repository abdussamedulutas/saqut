IR DUMP

NAME=sideEffect PARAMS=0 SLOTS=1
    0  LOAD_STRING     s0 = "once"
    1  CALLHOST        print(s0)

NAME=main PARAMS=0 SLOTS=3
    0  CALL            s0 = sideEffect()
    1  LOAD_STRING     s1 = "after"
    2  CALLHOST        print(s1)
    3  LOAD_CONST      s2 = 0
    4  RETURN          return s2

END
