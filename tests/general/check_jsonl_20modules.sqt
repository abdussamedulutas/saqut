import {val19} from "check_jsonl_modules/mod_19.sqt";

int main() {
    int total = val00() + val01() + val02() + val03() + val04() + val05() +
                val06() + val07() + val08() + val09() + val10() + val11() +
                val12() + val13() + val14() + val15() + val16() + val17() +
                val18() + val19();
    print(total);
    return 0;
}
