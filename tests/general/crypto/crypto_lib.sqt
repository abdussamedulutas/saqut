// Basit LCG tabanlı deterministik PRNG (glibc rand() sabitleri) — kripto
// amaçlı DEĞİL, yalnızca tekrarlanabilir stres verisi üretmek için.
int rngState = 123456789;

byte nextByte() {
    rngState = rngState * 1103515245 + 12345;
    int v = rngState & 255;
    return v as byte;
}

// out'a n adet pseudo-random byte push eder.
export void genPlaintext(int n, byte[] out) {
    int i = 0;
    while (i < n) {
        out.push(nextByte());
        i = i + 1;
    }
}

export void xorBytes(byte[] a, byte[] b, byte[] out) {
    int i = 0;
    while (i < a.length()) {
        int v = (a[i] as int) ^ (b[i] as int);
        out.push(v as byte);
        i = i + 1;
    }
}

export void subBytes(byte[] block, byte[] box, byte[] out) {
    int i = 0;
    while (i < block.length()) {
        int idx = block[i] as int;
        out.push(box[idx]);
        i = i + 1;
    }
}

// 4x4 state (row-major), satır r sola r kadar dairesel kaydırma.
// Gerçek AES ShiftRows'un taklidi, birebir aynı değil.
export void shiftRows(byte[] block, byte[] out) {
    int r = 0;
    while (r < 4) {
        int c = 0;
        while (c < 4) {
            int srcCol = (c + r) % 4;
            out.push(block[r * 4 + srcCol]);
            c = c + 1;
        }
        r = r + 1;
    }
}

export void invShiftRows(byte[] block, byte[] out) {
    int r = 0;
    while (r < 4) {
        int c = 0;
        while (c < 4) {
            int srcCol = (c - r + 4) % 4;
            out.push(block[r * 4 + srcCol]);
            c = c + 1;
        }
        r = r + 1;
    }
}

// Toy diffusion (GERÇEK MixColumns DEĞİL, GF(2^8) çarpımı yok).
// Sütun başına: m0=b1, m1=b2, m2=b3, m3=b0^b1^b2^b3 — tersinir
// permütasyon+parite kombinasyonu.
export void mixToy(byte[] block, byte[] out) {
    int col = 0;
    while (col < 4) {
        int base = col * 4;
        int b0 = block[base] as int;
        int b1 = block[base + 1] as int;
        int b2 = block[base + 2] as int;
        int b3 = block[base + 3] as int;
        out.push(b1 as byte);
        out.push(b2 as byte);
        out.push(b3 as byte);
        out.push((b0 ^ b1 ^ b2 ^ b3) as byte);
        col = col + 1;
    }
}

export void invMixToy(byte[] block, byte[] out) {
    int col = 0;
    while (col < 4) {
        int base = col * 4;
        int m0 = block[base] as int;
        int m1 = block[base + 1] as int;
        int m2 = block[base + 2] as int;
        int m3 = block[base + 3] as int;
        int b0 = m3 ^ m0 ^ m1 ^ m2;
        out.push(b0 as byte);
        out.push(m0 as byte);
        out.push(m1 as byte);
        out.push(m2 as byte);
        col = col + 1;
    }
}

// Toy key schedule: gerçek AES key expansion DEĞİL. Her round key önceki
// round key'in SBOX'tan geçirilmiş hali + basit bir round sabitiyle
// XOR'lanarak üretilir. `out`, düz (flat) byte[] — uzunluk 16*(rounds+1).
export void roundKeysToy(byte[] key16, int rounds, byte[] out) {
    int i = 0;
    while (i < 16) {
        out.push(key16[i]);
        i = i + 1;
    }
    int r = 1;
    while (r <= rounds) {
        int baseIdx = (r - 1) * 16;
        byte[] prevKey = out.slice(baseIdx, baseIdx + 16);
        byte[] subbed = [];
        subBytes(prevKey, SBOX, subbed);
        int j = 0;
        while (j < 16) {
            int v = subbed[j] as int;
            if (j == 0) {
                v = v ^ r;
            }
            out.push(v as byte);
            j = j + 1;
        }
        r = r + 1;
    }
}

export void encryptBlock(byte[] block16, byte[] roundKeys, int rounds, byte[] out) {
    byte[] state = [];
    xorBytes(block16, roundKeys.slice(0, 16), state);
    int r = 1;
    while (r <= rounds) {
        byte[] subbed = [];
        subBytes(state, SBOX, subbed);
        byte[] shifted = [];
        shiftRows(subbed, shifted);
        byte[] mixed = shifted;
        if (r < rounds) {
            mixed = [];
            mixToy(shifted, mixed);
        }
        int base = r * 16;
        byte[] rk = roundKeys.slice(base, base + 16);
        byte[] next = [];
        xorBytes(mixed, rk, next);
        state = next;
        r = r + 1;
    }
    int i = 0;
    while (i < state.length()) {
        out.push(state[i]);
        i = i + 1;
    }
}

export void decryptBlock(byte[] block16, byte[] roundKeys, int rounds, byte[] out) {
    int base = rounds * 16;
    byte[] rk = roundKeys.slice(base, base + 16);
    byte[] state = [];
    xorBytes(block16, rk, state);
    int r = rounds;
    while (r >= 1) {
        byte[] unmixed = state;
        if (r < rounds) {
            unmixed = [];
            invMixToy(state, unmixed);
        }
        byte[] unshifted = [];
        invShiftRows(unmixed, unshifted);
        byte[] subbed = [];
        subBytes(unshifted, INV_SBOX, subbed);
        base = (r - 1) * 16;
        rk = roundKeys.slice(base, base + 16);
        byte[] next = [];
        xorBytes(subbed, rk, next);
        state = next;
        r = r - 1;
    }
    int i = 0;
    while (i < state.length()) {
        out.push(state[i]);
        i = i + 1;
    }
}

export bool arraysEqual(byte[] a, byte[] b) {
    if (a.length() != b.length()) {
        return false;
    }
    int i = 0;
    while (i < a.length()) {
        if (a[i] != b[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// totalBytes'lık pseudo-random plaintext üretir, 16 byte'lık bloklar halinde
// şifreler/çözer, roundtrip doğruluğunu ve bir XOR checksum'ı basar.
// Boyut arttıkça array push/slice/GC baskısını gözlemlemek için tasarlandı.
export void runCryptoStress(int totalBytes, int rounds) {
    byte[] key = [];
    genPlaintext(16, key);
    byte[] roundKeys = [];
    roundKeysToy(key, rounds, roundKeys);
    byte[] plaintext = [];
    genPlaintext(totalBytes, plaintext);

    int numBlocks = totalBytes / 16;
    byte[] ciphertext = [];
    int i = 0;
    while (i < numBlocks) {
        byte[] block = plaintext.slice(i * 16, i * 16 + 16);
        byte[] enc = [];
        encryptBlock(block, roundKeys, rounds, enc);
        int j = 0;
        while (j < 16) {
            ciphertext.push(enc[j]);
            j = j + 1;
        }
        i = i + 1;
    }

    byte[] decrypted = [];
    i = 0;
    while (i < numBlocks) {
        byte[] block = ciphertext.slice(i * 16, i * 16 + 16);
        byte[] dec = [];
        decryptBlock(block, roundKeys, rounds, dec);
        int j = 0;
        while (j < 16) {
            decrypted.push(dec[j]);
            j = j + 1;
        }
        i = i + 1;
    }

    int checksum = 0;
    i = 0;
    while (i < ciphertext.length()) {
        checksum = checksum ^ (ciphertext[i] as int);
        i = i + 1;
    }

    print(plaintext.length());
    print(",");
    print(ciphertext.length());
    print(",");
    print(arraysEqual(plaintext, decrypted));
    print(",");
    print(checksum);
    print("\n");
}
