int main() {
    int[] a = [10, 20, 30];
    print(a.length());          // 3
    print(a.push(40));        // 3 (index of new element)
    print(a.length());          // 4
    print(a.pop());             // 40
    print(a.length());          // 3
    
    print(a.insert(1, 15));   // 1
    print(a[1]);                    // 15
    print(a.remove(1));       // 15
    print(a[1]);                    // 20
    
    int[] b = a.slice(1, 3);
    print(b.length());          // 2
    print(b[0]);                    // 20

    b.reverse();
    print(b[0]);                    // 30

    int[] c = a.concat(b);
    print(c.length());          // 5

    print(c.contains(20));    // 1 (true)
    print(c.contains(99));    // 0 (false)

    print(c.indexOf(30));     // 2
    print(c.indexOf(99));     // null

    c.clear();
    print(c.length());          // 0
    return 0;
}
