int main() {
    int[] a = [10, 20, 30];
    print(int::length(a));          // 3
    print(int::push(a, 40));        // 3 (index of new element)
    print(int::length(a));          // 4
    print(int::pop(a));             // 40
    print(int::length(a));          // 3
    
    print(int::insert(a, 1, 15));   // 1
    print(a[1]);                    // 15
    print(int::remove(a, 1));       // 15
    print(a[1]);                    // 20
    
    int[] b = int::slice(a, 1, 3);
    print(int::length(b));          // 2
    print(b[0]);                    // 20

    int::reverse(b);
    print(b[0]);                    // 30

    int[] c = int::concat(a, b);
    print(int::length(c));          // 5

    print(int::contains(c, 20));    // 1 (true)
    print(int::contains(c, 99));    // 0 (false)

    print(int::indexOf(c, 30));     // 2
    print(int::indexOf(c, 99));     // null

    int::clear(c);
    print(int::length(c));          // 0
    return 0;
}
