int main() {
    string s = "  Hello World  ";
    print(s.length());
    print(s.upper());
    print(s.lower());
    print(s.trim());

    string csv = "a,b,c";
    string[] parts = csv.split(",");
    print(parts.length());
    print(parts[0]);
    print(parts[1]);
    print(parts[2]);

    return 0;
}
