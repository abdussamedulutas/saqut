struct Point {
    int x;
    int y;
}

int main() {
    Point[] arr = [];

    Point p1;
    p1.x = 10;
    p1.y = 20;

    Point p2;
    p2.x = 30;
    p2.y = 40;

    int idx1 = arr.push(p1);
    int idx2 = arr.push(p2);
    print(idx1);
    print(idx2);
    print(arr.length());

    print(arr[0].x);
    print(arr[1].y);

    print(arr.contains(p1));
    print(arr.contains(p2));

    arr.reverse();
    print(arr[0].x);

    Point popped = arr.pop();
    print(popped.x);
    print(arr.length());

    arr.clear();
    print(arr.length());

    return 0;
}
