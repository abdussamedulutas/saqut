// ADR-040: `double` = 64-bit IEEE (temiz ondalık); float32 ayrımı için
// bkz. numeric_widths.sqt (single precision davranışı).
int main() {
    double x = 3.14;
    double y = 2.0;
    print(x + y);
    print(x * y);
    print(x - y);
    print(x / y);
    double z = 1;
    print(z);
    return 0;
}
