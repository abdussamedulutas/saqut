import {writeFile, appendFile, readFile, existsFile, removeFile} from fs;

void main() {
    string path = "/tmp/saqut_fs_test_append.txt";
    print(existsFile(path));
    writeFile(path, "a".toBuffer());
    appendFile(path, "b".toBuffer());
    print(readFile(path).toString());
    print(existsFile(path));
    removeFile(path);
    print(existsFile(path));
}
