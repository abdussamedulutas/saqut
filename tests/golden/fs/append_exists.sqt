import {writeFile, append, readFile, exists, remove} from fs;

void main() {
    string path = "/tmp/saqut_fs_test_append.txt";
    print(exists(path));
    writeFile(path, "a".toBuffer());
    append(path, "b".toBuffer());
    print(readFile(path).toString());
    print(exists(path));
    remove(path);
    print(exists(path));
}
