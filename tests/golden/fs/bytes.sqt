import {writeBytes, readBytes, remove} from fs;

void main() {
    byte[] data = [72, 73, 33];
    string path = "/tmp/saqut_fs_test_bytes.bin";
    writeBytes(path, data);
    byte[] back = readBytes(path);
    print(back.length());
    print(back[0]);
    print(back[1]);
    print(back[2]);
    remove(path);
}
