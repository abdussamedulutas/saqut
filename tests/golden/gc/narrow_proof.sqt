// Kök daraltma ölçümü: erken kullanılıp ÖLEN (ama üzerine yazılmayan)
// array'ler + tahsis döngüsü. Daraltma kapalıysa ölü array'ler sona
// kadar kök kalır; açıksa toplanır.
int main() {
    int[] a1 = [1, 2, 3];
    int[] a2 = [4, 5, 6];
    int[] a3 = [7, 8, 9];
    int[] a4 = [10, 11, 12];
    int[] a5 = [13, 14, 15];
    print(a1[0]);
    print(a2[0]);
    print(a3[0]);
    print(a4[0]);
    print(a5[0]);
    // a1..a5 artık ölü; slot'ları yeniden kullanılmıyor
    int i = 0;
    while (i < 3000) {
        int[] cop = [i];
        i = i + 1;
    }
    print("OK");
    return 0;
}
