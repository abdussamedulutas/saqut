// Sabit katlama, taşmayı VM ile AYNI şekilde hesaplamalı (ADR-040).
//
// Hata sınıfı — sessiz ayrışma: katlama düz C++ `l + r` kullanırsa bu
// signed overflow'dur, yani UB. Derleyici "taşma olmaz" varsayıp farklı
// sonuç üretebilir; VM ise tanımlı 2's-complement wrap yapar. Optimizasyon
// VARSAYILAN AÇIK olduğundan böyle bir ayrışma doğrudan kullanıcıya ulaşır.
//
// Bu fixture'daki her ifade iki taraf da sabit olduğu için KATLANIR.
// tests/run.sh "optimizasyon sonucu degistirmiyor" gate'i aynı programı
// --dont-optimize ile de koşar; iki sonuç eşit olmak zorundadır.
int main() {
    // Toplama/çıkarma/çarpma taşması
    print(2147483647 + 1);
    print(2147483647 * 2);
    print(-2147483647 - 2);
    print(100000 * 100000);

    // Kaydırma: miktar >= 32 ise C++'ta UB, x86/MIR 5 bit maskeler
    print(1 << 32);
    print(1 << 33);
    print(255 >> 40);
    print(-8 >> 1);

    // INT_MIN kenarı
    print(-2147483647 - 1);
    return 0;
}
