# Faz 5 (#84): çok dosyalı rename — import edilen fonksiyon kullanım
# noktasından yeniden adlandırılır; WorkspaceEdit HER İKİ dosyanın URI'sini
# içerir (tanım importee'de, kullanım importer'da).
{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"processId":null,"rootUri":null,"capabilities":{}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file://%FIXDIR%/importee.sqt","languageId":"sqt","version":1,"text":"export int helper(int n) {\n    return n + 1;\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file://%FIXDIR%/importer.sqt","languageId":"sqt","version":1,"text":"import { helper } from \"importee.sqt\";\n\nint main() {\n    int r = helper(5);\n    return r;\n}\n"}}}
{"jsonrpc":"2.0","id":2,"method":"textDocument/rename","params":{"textDocument":{"uri":"file://%FIXDIR%/importer.sqt"},"position":{"line":3,"character":12},"newName":"yardimci"}}
