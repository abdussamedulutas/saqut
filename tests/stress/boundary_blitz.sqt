// Sinir degerleri

int main() {
    int errors = 0;
    
    // 1. byte sinir degerleri
    byte b0 = 0 as byte;
    byte b255 = 255 as byte;
    if ((b0 as int) != 0) { errors = errors + 1; }
    if ((b255 as int) != 255) { errors = errors + 1; }
    
    // 2. float -> int truncation
    int fi = (3.9) as int;
    if (fi != 3) { errors = errors + 1; }
    
    // 3. byte[] indexOf null donus
    byte[] ba = [10, 20, 30];
    int? idx = ba.indexOf(99);
    if (idx != null) { errors = errors + 1; }
    
    // 4. int[] clear sonrasi push
    int[] ia = [1, 2, 3, 4, 5];
    ia.clear();
    if (ia.length() != 0) { errors = errors + 1; }
    ia.push(100);
    if (ia[0] != 100) { errors = errors + 1; }
    if (ia.length() != 1) { errors = errors + 1; }
    
    // 5. longint array
    longint[] longs = [];
    int i = 0;
    while (i < 100) {
        longs.push(i * 1000000000);
        i = i + 1;
    }
    if (longs.length() != 100) { errors = errors + 1; }
    if (longs[50] != 50000000000) { errors = errors + 1; }
    
    // 6. nested array slice + concat chain
    byte[] a = [];
    i = 0;
    while (i < 100) {
        a.push((i & 255) as byte);
        i = i + 1;
    }
    byte[] b = a.slice(20, 40);
    byte[] c = b.slice(5, 15);
    byte[] d = a.slice(0, 10).concat(c);
    if (d.length() != 20) { errors = errors + 1; }
    
    // 7. 1-element array
    byte[] one = [99];
    if (one.length() != 1) { errors = errors + 1; }
    if ((one[0] as int) != 99) { errors = errors + 1; }
    byte[] oneSliced = one.slice(0, 1);
    if (oneSliced.length() != 1) { errors = errors + 1; }
    if ((oneSliced[0] as int) != 99) { errors = errors + 1; }
    
    // 8. type mixing concat
    byte[] x = [10];
    byte[] y = [20];
    byte[] z = x.concat(y);
    if (z.length() != 2) { errors = errors + 1; }
    if ((z[0] as int) != 10 || (z[1] as int) != 20) { errors = errors + 1; }
    
    // 9. int[] insert/remove many
    int[] ins = [];
    i = 0;
    while (i < 1000) {
        ins.push(i);
        i = i + 1;
    }
    int removed = 0;
    i = 0;
    while (i < 500) {
        removed = removed + ins.remove(0);
        i = i + 1;
    }
    if (removed != 124750) { errors = errors + 1; }  // sum of 0..499
    if (ins.length() != 500) { errors = errors + 1; }
    
    // 10. multiple GC rounds with byte[]
    i = 0;
    while (i < 10000) {
        byte[] tmp = [];
        int j = 0;
        while (j < 100) {
            tmp.push((j & 255) as byte);
            j = j + 1;
        }
        tmp.slice(0, 50);
        i = i + 1;
    }
    
    print(errors);
    print(": boundary errors\n");
    return errors;
}
