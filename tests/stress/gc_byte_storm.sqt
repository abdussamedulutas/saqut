// GC byte[] storm testi — & 255 ile byte sinirina uygun

int main() {
    int iter = 0;
    int total = 50000;
    
    while (iter < total) {
        byte[] tmp = [];
        int j = 0;
        while (j < 16) {
            int v = (iter + j) & 255;
            tmp.push(v as byte);
            j = j + 1;
        }
        iter = iter + 1;
    }
    
    print(total);
    print(",");
    print(iter);
    print(": gc byte storm done\n");
    return 0;
}
